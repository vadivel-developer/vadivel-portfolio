# Copy this file to .env.local and add at least ONE key. All three have a free tier.
# The assistant tries them in this order and falls back to the next if one is rate limited.

# Google Gemini  (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# Groq - fast Llama models  (free key: https://console.groq.com/keys)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter - has several free models  (free key: https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Your public site address (sent to OpenRouter as the referrer)
# SITE_URL=https://your-site.vercel.app
